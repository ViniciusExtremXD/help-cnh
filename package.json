{
  "name": "help-solucoes-cnh",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Help Soluções e CNH — landing page de defesa do motorista",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5174",
    "build:gh": "cross-env VITE_BASE=/help-cnh/ npm run build",
    "deploy:gh": "npm run build:gh && gh-pages -d dist --nojekyll -m \"Deploy\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.1",
    "@fontsource-variable/plus-jakarta-sans": "^5.1.1",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "gh-pages": "^6.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
